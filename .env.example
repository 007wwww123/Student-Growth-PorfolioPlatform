# 复制为 .env 后按环境修改；不要提交真实密钥
MYSQL_ROOT_PASSWORD=change-me
DB_NAME=student_growth
JWT_SECRET=please-change-this-to-a-random-32-plus-character-secret
# base64 编码的 32 字节 AES 密钥；生成：openssl rand -base64 32
ID_CARD_KEY=
MINIO_ROOT_USER=growth
MINIO_ROOT_PASSWORD=change-me-minio
# 中文字体：把 simhei.ttf 放到 ./fonts/ 下，镜像内路径 /fonts/simhei.ttf
